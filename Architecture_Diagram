        subgraph "Main API Server"
            APP[🚀 Hono.js Server<br/>Bun Runtime<br/>Docker Container<br/>Port 3000]
            HEALTH[💚 Health Check<br/>/health endpoint<br/>30s intervals]
        end
    end
    
    subgraph "AI/ML Service - Railway"
        subgraph "Vector Search API"
            VECTOR_API[🐍 Python FastAPI<br/>Uvicorn Server<br/>Port 8000]
            VECTOR_HEALTH[💚 Health Check<br/>/health endpoint<br/>Model Status]
        end
        
        subgraph "ML Models & NLP"
            EMBEDDINGS[🤖 Sentence Transformers<br/>paraphrase-multilingual<br/>768-dim vectors]
            NLP_ENGINE[🧠 NLP Engine<br/>spaCy + Custom Rules<br/>Query Understanding]
        end
        
        subgraph "Search Services"
            VECTOR_SEARCH[🔍 Vector Search<br/>Semantic Similarity<br/>pgvector]
            SMART_SEARCH[🧠 Smart Search<br/>NLP + Synonyms<br/>Multi-query Ranking]
